CREATE TABLE measurement (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    exercise TEXT NOT NULL,
    hand TEXT NOT NULL,
    kg REAL NOT NULL,
    epoch_millis INTEGER NOT NULL,
    source TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT ''
);

CREATE INDEX measurement_time ON measurement(epoch_millis);

CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectAll:
SELECT * FROM measurement ORDER BY epoch_millis DESC;

insert:
INSERT INTO measurement(exercise, hand, kg, epoch_millis, source, note) VALUES (?, ?, ?, ?, ?, ?);

lastId:
SELECT last_insert_rowid();

deleteById:
DELETE FROM measurement WHERE id = ?;

deleteAll:
DELETE FROM measurement;

selectSetting:
SELECT value FROM setting WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);
